WOO_URL=https://shop.example.com
WOO_CONSUMER_KEY=ck_xxx          # WooCommerce → Settings → Advanced → REST API, permissions: Read (or Read/Write if you enable writes)
WOO_CONSUMER_SECRET=cs_xxx
WOO_ALLOW_WRITES=false           # true lets apply_proposal execute *approved* proposals
WOO_REDACT_PII=true              # mask customer emails/phones/street addresses in tool output
WOO_PROPOSALS_FILE=.woo-proposals.json
# HTTP transport only
MCP_HTTP_TOKEN=                  # for the agent (POST /mcp)
MCP_ADMIN_TOKEN=                 # for the human approver (GET/POST /proposals) — must differ
